# The parent repository's root .gitignore blanket-ignores *.md, env/, *.csv and more.
# MIRAGE needs its docs and env spec tracked — re-include them here
# (deeper .gitignore patterns take precedence).
!*.md
# paper figures are deliverables; the root .gitignore blanket-ignores *.pdf
!paper/*.pdf
!env/
!env/**
!configs/*.yaml

# Large / regenerable artifacts (fetch or build scripts reproduce them).
# The fetch script and the SHA256 manifest ARE tracked — they are the
# reproducibility artifact; the data they produce is not.
data/raw/*
!data/raw/fetch.py
!data/raw/MANIFEST.json
data/activations/
*.npz
*.pt
